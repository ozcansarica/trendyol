# Veritabanı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trendyol_analiz
DB_USER=db_kullanici
DB_PASS=guclu_bir_sifre

# Trendyol API (varsayılan mağaza — genellikle DB'den gelir)
TY_SELLER_ID=
TY_API_KEY=
TY_API_SECRET=

# Uygulama
# APP_KEY: sosyal medya token'larını şifreler. Uzun rastgele bir değer verin
#   (ör. `php -r "echo bin2hex(random_bytes(32));"`) ve sonradan DEĞİŞTİRMEYİN —
#   değişirse bağlı hesaplar yeniden bağlanmalıdır.
APP_KEY=
# APP_URL: sitenin kök adresi (sonunda / olmadan). Facebook OAuth yönlendirmesi
#   APP_URL/facebook_callback.php olur. Boşsa istekten türetilir.
APP_URL=
APP_TIMEZONE=Europe/Istanbul

# Facebook (Sosyal Paylaşım) — developers.facebook.com → Uygulama → Ayarlar → Temel
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v23.0
