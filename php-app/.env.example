# ------------------------------------------------------------
# Bu dosyayı elle oluşturmanız gerekmez: kurulum.php sihirbazı
# veritabanı bilgilerini ve APP_KEY'i kendisi yazar. Aşağıdaki
# diğer tüm ayarlar Admin Paneli → Sistem Ayarları'ndan yönetilir;
# burada verilirlerse panelde değer girilmediği sürece kullanılır.
# ------------------------------------------------------------

# APP_KEY: sosyal medya token'larını ve gizli ayarları şifreler.
#   Kurulum sihirbazı otomatik üretir. Sonradan DEĞİŞTİRMEYİN.
APP_KEY=

# İsteğe bağlı (panelden de girilebilir)
# APP_URL=https://ornek.com
# APP_TIMEZONE=Europe/Istanbul
# FB_APP_ID=
# FB_APP_SECRET=
# FB_GRAPH_VERSION=v23.0
